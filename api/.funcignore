# Azure Functions Deployment Exclusions
# Files and directories to exclude from deployment package

# Local settings
local.settings.json
*.local.json

# Node.js
node_modules/.bin
.npm
.node_repl_history

# Build artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
scripts/test-*.js
*.test.js
*.spec.js

# Development files
.env.local
.env.development

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation
README.md
docs/

# Database files (stored in Azure Blob)
database/

# Old server files (not needed for Functions)
../server/
../client/
