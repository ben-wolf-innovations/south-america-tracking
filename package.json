{
  "name": "south-america-tracking",
  "version": "1.0.0",
  "description": "Web app for tracking 6-month South America trip with route mapping, cost tracking, and blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "cd api && npm start",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install && cd ../api && npm install",
    "test:db": "cd api && npm test"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "keywords": [
    "travel",
    "tracking",
    "south-america",
    "azure-functions"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
